# CineVerse — environment template
# Copy this file to .env and fill the values. NEVER commit the real .env.

# SQLite database file (Prisma)
DATABASE_URL=file:./db/custom.db

# HMAC secret for signed session cookies (generate: openssl rand -hex 32)
AUTH_SECRET=replace-with-a-64-char-random-hex-string

# ————— Optional: Google Sign-In (needs Google Cloud Console setup) —————
# Without these, the app works with zero-config accounts (email/username + password).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
